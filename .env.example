# Required: Your email for polite-pool access to Crossref, OpenAlex, and Unpaywall.
# Used as the `mailto` query param / User-Agent contact. Gets you better rate limits.
CROSSREF_MAILTO=varma2friend@gmail.com

# Optional: OpenAlex Premium API key. When set, sent as `api_key` query param on every
# OpenAlex request — bypasses the polite-pool rate cap (10 req/s) and unlocks premium features.
OPENALEX_API_KEY=
